    Avatar.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    Avatar.BorderSizePixel = 0
    Avatar.Image = GetAvatar(tonumber(userId) or 1)
    Avatar.Parent = Container

    local AvatarCorner = Instance.new("UICorner")
    AvatarCorner.CornerRadius = UDim.new(1, 0)
    AvatarCorner.Parent = Avatar

    local Msg = Instance.new("TextLabel")
    Msg.Size = UDim2.new(1, -36, 0, 0)
    Msg.Position = UDim2.new(0, 34, 0, 4)
    Msg.BackgroundTransparency = 1
    Msg.Text = name .. ": " .. text
    Msg.TextColor3 = color
    Msg.Font = Enum.Font.Gotham
    Msg.TextSize = 15
    Msg.TextWrapped = true
    Msg.TextXAlignment = Enum.TextXAlignment.Left
    Msg.AutomaticSize = Enum.AutomaticSize.Y
    Msg.Parent = Container

    task.defer(function()
        ChatBox.CanvasPosition = Vector2.new(0, ChatBox.AbsoluteCanvasSize.Y)
    end)
end

local function SendMessage()
    local msg = TextBox.Text
    if not msg or msg:match("^%s*$") then return end

    local sendUserId = (FakeNameEnabled and FakeUserId) or LocalPlayer.UserId
    local sendName = (FakeNameEnabled and FakeDisplayName) or LocalPlayer.DisplayName

    -- Nếu Fake Name đang bật nhưng chưa chọn tên giả thì dùng tài khoản thật
    if not sendUserId then
        sendUserId = LocalPlayer.UserId
    end
    if not sendName or sendName == "" then
        sendName = LocalPlayer.DisplayName
    end

    local full = sendUserId .. "|" .. sendName .. "|" .. msg
    TextBox.Text = ""

    AddMessage(sendUserId, sendName, msg, true)

    task.spawn(function()
        local req = GetRequest()
        if not req then return end
        pcall(function()
            req({
                Url = API,
                Method = "POST",
                Headers = {["Content-Type"] = "text/plain", ["Title"] = sendName},
                Body = full
            })
        end)
    end)
end

SendBtn.MouseButton1Click:Connect(SendMessage)
