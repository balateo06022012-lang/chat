-- Fake Name logic
local function GetRequest()
    return (syn and syn.request) or (http and http.request) or request or http_request
end

local function ApplyFakeName()
    if not isOwner or not FakeNameEnabled then return end
    local username = FakeNameBox.Text:gsub("%s+", "")
    if username == "" then
        FakeUserId = nil
        FakeDisplayName = nil
        AddMessage(1, "Hệ thống", "Đã về tên gốc", false)
        return
    end

    task.spawn(function()
        local success, userId = pcall(function()
            return Players:GetUserIdFromNameAsync(username)
        end)

        if not success or not userId then
            AddMessage(1, "Hệ thống", "Không tìm thấy username: " .. username, false)
            return
        end

        local displayName = username
        local req = GetRequest()
        if req then
            local ok, res = pcall(function()
                return req({
                    Url = "https://users.roblox.com/v1/users/" .. userId,
                    Method = "GET"
                })
            end)
            if ok and res and res.Body then
                local data = HttpService:JSONDecode(res.Body)
                if data and data.displayName then
                    displayName = data.displayName
                end
            end
        end

        FakeUserId = userId
        FakeDisplayName = displayName
        AddMessage(1, "Hệ thống", "Đã đổi thành: " .. displayName .. " (@" .. username .. ")", false)
    end)
end

ApplyBtn.MouseButton1Click:Connect(ApplyFakeName)
FakeNameBox.FocusLost:Connect(function(enter)
    if enter then ApplyFakeName() end
end)

-- Logic chính
local LastMessageId = "all"
local Seen = {}
local NameColors = {}
local AvatarCache = {}

local ColorList = {
    Color3.fromRGB(120, 190, 255),
    Color3.fromRGB(255, 140, 180),
    Color3.fromRGB(130, 230, 160),
    Color3.fromRGB(255, 200, 100),
    Color3.fromRGB(190, 140, 255),
    Color3.fromRGB(255, 160, 120),
    Color3.fromRGB(100, 220, 220),
    Color3.fromRGB(255, 120, 120),
}

local function GetNameColor(name)
    if NameColors[name] then return NameColors[name] end
    local index = 0
    for i = 1, #name do index = index + string.byte(name, i) end
    local color = ColorList[(index % #ColorList) + 1]
    NameColors[name] = color
    return color
end

local function GetAvatar(userId)
    if AvatarCache[userId] then return AvatarCache[userId] end
    local success, content = pcall(function()
        return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
    end)
    if success then
        AvatarCache[userId] = content
        return content
    end
    return "rbxasset://textures/ui/GuiImagePlaceholder.png"
end

local function AddMessage(userId, name, text, isMe)
