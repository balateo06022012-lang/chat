    if enter then SendMessage() end
end)

task.spawn(function()
    while task.wait(POLL_INTERVAL) do
        local req = GetRequest()
        if not req then continue end

        local success, result = pcall(function()
            return req({
                Url = API .. "/json?poll=1&since=" .. HttpService:UrlEncode(tostring(LastMessageId)),
                Method = "GET"
            })
        end)

        if success and result and result.Body and result.Body ~= "" then
            -- ntfy /json?poll=1 returns NDJSON: one JSON event per line
            for line in result.Body:gmatch("[^\r\n]+") do
                local ok, msg = pcall(function()
                    return HttpService:JSONDecode(line)
                end)

                if ok and type(msg) == "table" and msg.event == "message" and msg.id then
                    if not Seen[msg.id] then
                        Seen[msg.id] = true

                        -- ntfy message ID là chuỗi, không phải số
                        if type(msg.id) == "string" then
                            LastMessageId = msg.id
                        end

                        local body = msg.message or ""
                        local userId, name, text =
                            body:match("^(%d+)|([^|]+)|(.+)$")

                        if userId and name and text then
                            if tonumber(userId) ~= LocalPlayer.UserId then
                                AddMessage(
                                    tonumber(userId),
                                    name,
                                    text,
                                    false
                                )

                                if not Main.Visible then
                                    NotifySound:Play()
                                    ShowNotification(name, text)
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

